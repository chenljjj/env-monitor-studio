<Window x:Class="EnvMonitor.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Env Monitor Studio" Icon="Assets/环境检测器.ico" Width="1280" Height="820" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="12" />
      <RowDefinition Height="Auto" /><RowDefinition Height="12" />
      <RowDefinition Height="Auto" /><RowDefinition Height="12" />
      <RowDefinition Height="Auto" /><RowDefinition Height="12" />
      <RowDefinition Height="*" /><RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="环境监测开发调试台" FontSize="24" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="STM32 USART2 · ESP-IDF Monitor · MQTT" Foreground="#0F766E" /><TextBlock Text="  ·  " Foreground="#98A2B3" /><TextBlock Text="单窗口实时日志看板" Foreground="#667085" /></StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Content="清空日志" Margin="0,0,8,0" Click="ClearLogs_Click" />
      <Button Grid.Column="2" Content="导出日志" Margin="0,0,8,0" Click="ExportLogs_Click" />
      <Button Grid.Column="3" Content="连接设置" Style="{StaticResource AccentButton}" Click="OpenSettings_Click" />
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="STM32 串口" Foreground="#52606D" /><TextBlock Text="{Binding Stm32Status}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="{Binding Stm32Detail}" Foreground="#667085" Margin="0,4,0,0" FontSize="11" /></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ESP32 串口" Foreground="#52606D" /><TextBlock Text="{Binding Esp32Status}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="{Binding Esp32Detail}" Foreground="#667085" Margin="0,4,0,0" FontSize="11" /></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="MQTT Broker" Foreground="#52606D" /><TextBlock Text="{Binding MqttStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="{Binding MqttDetail}" Foreground="#667085" Margin="0,4,0,0" FontSize="11" /></StackPanel></Border>
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="1.45*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="温度" Foreground="#52606D" /><TextBlock Text="{Binding Temperature}" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="湿度" Foreground="#52606D" /><TextBlock Text="{Binding Humidity}" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="照度" Foreground="#52606D" /><TextBlock Text="{Binding Illuminance}" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
      <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="错误计数（按调试日志字段累计）" Foreground="#52606D" /><ItemsControl ItemsSource="{Binding ErrorCounters}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="72" Margin="0,0,4,0"><TextBlock Text="{Binding Name}" FontSize="10" Foreground="#667085" /><TextBlock Text="{Binding Count}" FontSize="19" FontWeight="SemiBold" Foreground="#B42318" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </Grid>

    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="实时日志" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{Binding LogSummary}" Foreground="#667085" FontSize="11" Margin="0,3,0,0" /></StackPanel><TextBox Grid.Column="1" Width="230" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按文本即时过滤当前日志" /></Grid>

    <Border Grid.Row="8" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="10" Padding="1">
      <DataGrid ItemsSource="{Binding VisibleLogs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="29" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFC" /><Setter Property="Foreground" Value="#52606D" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderBrush" Value="#E4E7EC" /><Setter Property="Padding" Value="10,8" /></Style></DataGrid.ColumnHeaderStyle>
        <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="BorderBrush" Value="#EEF2F6" /><Setter Property="Padding" Value="9,4" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style></DataGrid.CellStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="接收时间" Binding="{Binding TimeText}" Width="105" />
          <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="75" />
          <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="62" />
          <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="92" />
          <DataGridTextColumn Header="Sample" Binding="{Binding Sample}" Width="82" />
          <DataGridTextColumn Header="原始日志（已安全脱敏）" Binding="{Binding Text}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <DockPanel Grid.Row="10"><TextBlock Text="本地 SQLite 保留最近 24 小时 · 密码仅以 Windows DPAPI 保存在本机" Foreground="#667085" FontSize="10" /><TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdate}" Foreground="#0F766E" FontSize="10" /></DockPanel>
  </Grid>
</Window>
